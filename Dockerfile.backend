FROM golang:1.17-alpine AS builder

ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /src

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go env -w GOPROXY=https://goproxy.cn,direct \
    && go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/luban .

FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata bash

WORKDIR /apps/luban

COPY --from=builder /out/luban /apps/luban/luban
COPY etc /apps/luban/etc

EXPOSE 8999

ENTRYPOINT ["/apps/luban/luban"]
